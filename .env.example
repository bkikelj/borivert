# Kopiraj ovu datoteku u .env i popuni vrijednostima iz Firebase konzole
# (Project settings -> General -> Your apps -> Web app -> SDK setup and configuration).
# .env se NE commita (vec je u .gitignore) — svaka instanca aplikacije ga postavlja sama.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (Build -> App Check -> registriraj web app -> reCAPTCHA v3 -> kopiraj site key).
# Bez ovoga app i dalje radi, samo bez App Check zastite.
VITE_RECAPTCHA_SITE_KEY=
