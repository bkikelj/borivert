rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Borivert je osobna aplikacija — pisanje smije samo vlasnik (po e-mailu naloga),
    // citanje je javno (utrke nisu osjetljiv podatak), za javni pregled bez prijave.
    function isOwner() {
      return request.auth != null && request.auth.token.email == 'boris.kikelj@gmail.com';
    }

    match /races/{raceId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /trainings/{trainingId} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}
